<!DOCTYPE html>
<html>
    <head>
        <link rel="icon" href="/static/img/icon.png">
        <link rel="stylesheet" href="/static/styles/default.css">
        <% if (typeof title !== 'undefined') { %>
            <title><%= name + ' | ' + title %></title>
        <% } else { %>
            <title><%= name %></title>
        <% } %>
    </head>
    <body>
        <header>
            <a href="/"><%= name %></a>
            <div style="flex: auto;"></div>
            <a href="/new">New paste...</a>
        </header>
        <main>
            <%- include(templ, templParams); %>
        </main>
        <footer>
            This website is free software. You can find source code
            <a href="https://github.com/AlexandrPutenikhin/tastebin">
                here
            </a>.<br>
            &copy; 2026 Alexandr Putenikhin
        </footer>
    </body>
</html>
